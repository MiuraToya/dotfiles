// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Catppuccin Latte",
  "terminal": {
    
  },
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 15.0,
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^(ls|pwd|cat|echo|head|tail|wc|which|type|file|stat|du|df)(\\s|$)" },
            { "pattern": "^git\\s+(status|diff|log|branch|show|remote)(\\s|$)" },
            { "pattern": "^brew\\s+(list|info|search)(\\s|$)" },
            { "pattern": "^chezmoi\\s+(diff|status|data|source-path|managed|unmanaged)(\\s|$)" }
          ],
          "always_confirm": [
            { "pattern": "^sudo\\s+" },
            { "pattern": "rm\\s+-rf" }
          ]
        },
        "edit_file": { "default": "confirm" },
        "save_file": { "default": "confirm" },
        "delete_path": { "default": "confirm" },
        "create_directory": { "default": "confirm" },
        "move_path": { "default": "confirm" },
        "copy_path": { "default": "confirm" }
      }
    }
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access",
        "model": "gpt-5.5"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "buffer_font_features": {
    "calt": false
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
